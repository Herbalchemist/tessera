# SPDX-License-Identifier: GPL-3.0-or-later
# Bluetooth Xbox controllers were tagged as keyboards, so Chromium ignored them.
# Tag them as joysticks. Tested on an Xbox Elite 2 only.
SUBSYSTEM=="input", ATTRS{name}=="*Xbox*Controller*", ENV{ID_INPUT_JOYSTICK}="1"

# Nintendo controllers: Tessera reads them itself (Chromium leaves them out), and the Switch ones
# report their motion sensors (gyro, accelerometer) as a separate input device named "... (IMU)".
# Let the person at the console read all of them, like any other joystick. Read access only, and only
# for whoever is signed in at the screen (that is what "uaccess" means).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="057e", TAG+="uaccess"
