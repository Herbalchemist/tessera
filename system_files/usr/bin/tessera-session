#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Tessera console session. Started by the login manager via tessera.desktop.
# Runs the launcher inside Gamescope and restarts it if it crashes.
# Settings > Opus (or Ctrl+Q in a test build) ends the session and returns to the login
# screen, which is the way back to the desktop. The launcher says so by writing a note
# (TESSERA_LEAVE_FILE) just before it quits; the exit code of Gamescope is not trusted for that,
# because it is not reliable at shutdown. Without the note a non-zero exit is a crash: restart.
#
# When it is started from the desktop (tessera-return, "Return to Ludus") TESSERA_NESTED=1 is
# set: the same thing runs on top of the desktop, and leaving it shows the desktop again.

# Ludus: the console screen (Qt 6 + QML, in ludus-qt/), with the launcher's main process behind it
# (launcher/, run by the system's Node).
LUDUS=/usr/lib/tessera/ludus-qt/ludus.py
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tessera"
LOG="$STATE/session.log"
LEAVE="$STATE/leave-requested"
export TESSERA_LEAVE_FILE="$LEAVE"
MAX_QUICK_FAILS=3
QUICK_SECS=30
EARLY_EXIT_SECS=5

# Windows that other programs open (a web browser, say) should fill the screen
# like the launcher does, not sit at their own size. Newer Gamescope can force
# that; only ask for it if this build knows the option, so an older one can
# never fail to start because of it.
FORCE_FULL=""
if gamescope --help 2>&1 | grep -q -- '--force-windows-fullscreen'; then
  FORCE_FULL="--force-windows-fullscreen"
fi

# Display calibration for games too (Settings > Display calibration). Tessera
# writes a shader there only if the person turned that on. If Gamescope can't
# start with it, it is dropped for this session and a note is left so Tessera
# can say so, and nobody is ever locked out by it.
# Boot options > "Start Tessera with safe settings (this time)": no display calibration and no
# shards for this start (the launcher reads TESSERA_SAFE), so a setting gone wrong can be undone.
SAFE=""
[ "$(cat /run/tessera/boot-once 2>/dev/null)" = safe ] && SAFE=1
[ -n "$SAFE" ] && export TESSERA_SAFE=1
CAL_FX="${XDG_DATA_HOME:-$HOME/.local/share}/tessera/calibration/tessera-calibration.fx"
CAL_FAILED="$STATE/calibration-failed"
FX_ARGS=()
if [ -z "$SAFE" ] && [ -f "$CAL_FX" ] && [ ! -f "$CAL_FAILED" ] && gamescope --help 2>&1 | grep -q -- '--reshade-effect'; then
  FX_ARGS=(--reshade-effect "$CAL_FX")
  export TESSERA_CAL_SYSTEM=1
fi

# Pointers: Breeze's, with Tessera's busy pointer (its symbol building itself) while something loads.
[ -d /usr/share/icons/Tessera/cursors ] && export XCURSOR_THEME=Tessera

mkdir -p "$STATE"
# Keep the previous session's log for a while: what happened the last time is the first thing to look at.
[ -f "$LOG" ] && cp -f "$LOG" "$LOG.1" 2>/dev/null
echo "session start $(date -Is)${TESSERA_NESTED:+ (from the desktop)}" >"$LOG"
rm -f "$LEAVE"

# An account set up before it ran Tessera still has Bazzite's wallpaper in Opus: switch it
# to Tessera's, once (leaves a wallpaper the person picked alone). Only from the console session,
# when Plasma isn't running.
[ -z "$TESSERA_NESTED" ] && /usr/libexec/tessera/desktop-wallpaper >>"$LOG" 2>&1

# Without the launcher program there is nothing to run. Say so in the log and end the session
# (the login screen is the way to the desktop) instead of starting Gamescope with nothing in it.
if [ ! -f "$LUDUS" ] || ! python3 -c 'import PySide6.QtQuick' 2>>"$LOG"; then
  echo "Ludus missing or its Qt pieces (PySide6) are not installed: $LUDUS" >>"$LOG"
  exit 1
fi

# On top of Opus, gamescope runs nested in a window and doesn't look at the screen: without a size it
# draws 1280x720 and stretches it. Give it the main screen's size, so an ultrawide stays ultrawide.
SIZE_ARGS=()
if [ -n "${TESSERA_NESTED:-}" ] && read -r W H < <(/usr/libexec/tessera/display-size 2>/dev/null); then
  SIZE_ARGS=(-W "$W" -H "$H" -w "$W" -h "$H")
  echo "on top of the desktop: ${W}x${H}" >>"$LOG"
fi

RESTART="$STATE/restart-requested"
export TESSERA_RESTART_FILE="$RESTART"
NO_DISPLAY=""
fails=0
while true; do
  started=$(date +%s)
  PROGRAM=(python3 "$LUDUS")
  rm -f "$LEAVE" "$RESTART"
  # Settings > Screens: which screen, its resolution and refresh, a built-in screen's orientation
  # (display-info reads the screens from the driver; a setting being tried is used for one start).
  DISPLAY_ARGS=()
  if [ -z "${TESSERA_NESTED:-}" ] && [ -z "$NO_DISPLAY" ] && [ -z "$SAFE" ]; then
    mapfile -t DISPLAY_ARGS < <(/usr/libexec/tessera/display-info args 2>>"$LOG")
    [ "${#DISPLAY_ARGS[@]}" -gt 0 ] && echo "screen settings: ${DISPLAY_ARGS[*]}" >>"$LOG"
  fi
  gamescope -f $FORCE_FULL "${SIZE_ARGS[@]}" "${DISPLAY_ARGS[@]}" "${FX_ARGS[@]}" -- "${PROGRAM[@]}" >>"$LOG" 2>&1
  code=$?
  echo "launcher exited with code $code" >>"$LOG"

  # Ludus asked to start again (new screen settings): no failure, no leaving.
  if [ -e "$RESTART" ]; then
    echo "restart asked for" >>"$LOG"
    rm -f "$RESTART"
    fails=0
    continue
  fi

  # Failed quickly with screen settings: start again with the screen's own choice. (A setting
  # being tried was already dropped by display-info for the next start.)
  if [ "$code" -ne 0 ] && [ "${#DISPLAY_ARGS[@]}" -gt 0 ] && [ $(( $(date +%s) - started )) -lt "$QUICK_SECS" ]; then
    echo "screen settings failed, starting with the screen's own choice" >>"$LOG"
    NO_DISPLAY=1
    continue
  fi

  # The person chose Opus: leave, whatever the exit code was.
  if [ -e "$LEAVE" ]; then
    echo "Opus was asked for: ending the session" >>"$LOG"
    rm -f "$LEAVE"
    exit 0
  fi

  # Gamescope reports success even when the program it was asked to run could not be started,
  # which used to look like a normal exit to Opus. Nobody gets to Opus within a
  # few seconds of starting, so a "clean" exit that quick is counted as a failure.
  if [ "$code" -eq 0 ] && [ $(( $(date +%s) - started )) -lt "$EARLY_EXIT_SECS" ]; then
    echo "launcher ended after less than ${EARLY_EXIT_SECS}s without being asked to: counted as a failure" >>"$LOG"
    code=1
  fi

  # Failed quickly with the calibration shader on: turn it off and try again.
  if [ "$code" -ne 0 ] && [ "${#FX_ARGS[@]}" -gt 0 ] && [ $(( $(date +%s) - started )) -lt "$QUICK_SECS" ]; then
    echo "calibration shader failed, starting without it" >>"$LOG"
    touch "$CAL_FAILED"
    FX_ARGS=()
    unset TESSERA_CAL_SYSTEM
    continue
  fi

  # Clean exit: end the session and return to the login screen.
  [ "$code" -eq 0 ] && exit 0

  # Crash guard: give up after several quick failures in a row,
  # so a broken launcher can't trap anyone in a restart loop.
  if [ $(( $(date +%s) - started )) -lt "$QUICK_SECS" ]; then
    fails=$((fails + 1))
  else
    fails=0
  fi
  if [ "$fails" -ge "$MAX_QUICK_FAILS" ]; then
    echo "too many quick failures, giving up" >>"$LOG"
    exit 1
  fi
  sleep 1
done
