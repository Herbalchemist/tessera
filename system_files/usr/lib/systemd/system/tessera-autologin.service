[Unit]
Description=Boot into Tessera (autologin), login screen for the desktop
Before=display-manager.service sddm.service plasmalogin.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /usr/libexec/tessera/autologin-setup

[Install]
WantedBy=multi-user.target
