[Desktop Entry]
Type=Application
Name=Open Ludus on top of Opus
GenericName=Console mode
Comment=Opens Ludus full screen and keeps Opus and its programs running underneath
Exec=/usr/bin/tessera-return --nested
Icon=tessera
Terminal=false
Categories=System;
Keywords=Tessera;console;gaming;games;controller;
StartupNotify=false
