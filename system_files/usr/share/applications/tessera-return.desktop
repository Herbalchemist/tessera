[Desktop Entry]
Type=Application
Name=Return to Tessera
GenericName=Console mode
Comment=Open Tessera full screen on top of the desktop
Exec=/usr/bin/tessera-return
Icon=tessera
Terminal=false
Categories=System;
Keywords=Tessera;console;gaming;games;controller;
StartupNotify=false
