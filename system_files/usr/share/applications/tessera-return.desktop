[Desktop Entry]
Type=Application
Name=Return to Ludus
GenericName=Console mode
Comment=Close Opus (the desktop) and start Ludus, Tessera's console
Exec=/usr/bin/tessera-return
Icon=tessera
Terminal=false
Categories=System;
Keywords=Tessera;console;gaming;games;controller;
StartupNotify=false
