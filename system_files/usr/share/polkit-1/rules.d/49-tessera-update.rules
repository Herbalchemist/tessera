// SPDX-License-Identifier: GPL-3.0-or-later
//
// Settings > Update software, and "Return to Tessera" on the desktop: the administrator sitting at
// the console may start and stop these five jobs (plus the graphics-build switch below) without a
// password, and nothing else. What each job
// runs is fixed in its unit file (bootc status, bootc upgrade --check, bootc upgrade, bootc rollback,
// and switch-to-tessera, which only ever restarts the login manager after the desktop session has
// ended); the person cannot hand it other commands or other arguments. Restarting afterwards is
// the normal "restart" permission of an active local session, so it needs no rule here.
//
// Written in plain ES5 on purpose: polkit's script engine is old.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units") {
    return polkit.Result.NOT_HANDLED;
  }
  // Only an administrator's account (the one Tessera's installer creates is one), at the console.
  // Anyone else, or a remote session, gets the normal password prompt.
  if (!subject.local || !subject.active || !subject.isInGroup("wheel")) {
    return polkit.Result.NOT_HANDLED;
  }
  var jobs = [
    "tessera-update-status.service",
    "tessera-update-check.service",
    "tessera-update-apply.service",
    "tessera-update-rollback.service",
    "tessera-session-switch.service"
  ];
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (jobs.indexOf(unit) !== -1 && (verb === "start" || verb === "stop")) {
    return polkit.Result.YES;
  }
  // After a graphics card swap: switch to the matching build. Only these three instances exist.
  if (/^tessera-graphics-switch@(standard|nvidia|nvidia-open)\.service$/.test(unit) && (verb === "start" || verb === "stop")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
