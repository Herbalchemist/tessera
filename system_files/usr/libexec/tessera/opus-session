#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Opus, Tessera's desktop, is KDE Plasma: this starts Plasma's own Wayland session, exactly as its
# login-screen entry does (the command is read from that entry, so it follows Plasma's updates).
set -u
for f in /usr/share/wayland-sessions/plasma.desktop /usr/share/wayland-sessions/plasmawayland.desktop; do
  [ -f "$f" ] || continue
  cmd=$(sed -n 's/^Exec=//p' "$f" | head -n1)
  [ -n "$cmd" ] && exec /bin/sh -c "exec $cmd"
done
exec /usr/bin/startplasma-wayland
